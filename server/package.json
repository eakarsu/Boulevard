{
  "name": "boulevard-clone-server",
  "version": "1.0.0",
  "description": "Backend API for Boulevard clone",
  "type": "module",
  "main": "dist/src/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/src/app.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "test": "jest",
    "test:smoke": "node --test tests/import-boundary.test.cjs",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^6.0.1",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^6.7.0",
    "pg": "^8.9.0",
    "redis": "^4.6.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "joi": "^17.8.3",
    "socket.io": "^4.6.1",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.1",
    "twilio": "^4.7.2",
    "stripe": "^11.16.0",
    "winston": "^3.8.2",
    "dotenv": "^16.0.3",
    "uuid": "^9.0.0",
    "date-fns": "^2.29.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/morgan": "^1.9.4",
    "@types/compression": "^1.7.2",
    "@types/pg": "^8.6.6",
    "@types/bcryptjs": "^2.4.2",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/node": "^18.14.6",
    "@types/node-cron": "^3.0.7",
    "@types/nodemailer": "^6.4.7",
    "@types/uuid": "^9.0.1",
    "typescript": "^4.9.5",
    "tsx": "^3.12.3",
    "jest": "^29.4.3",
    "@types/jest": "^29.4.0",
    "ts-jest": "^29.0.5"
  }
}
