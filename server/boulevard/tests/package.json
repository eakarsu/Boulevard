{
  "name": "boulevard-api-tests",
  "version": "1.0.0",
  "description": "Integration test suite for Boulevard API clone",
  "type": "module",
  "scripts": {
    "test": "mocha api.test.js --timeout 15000",
    "test:watch": "mocha api.test.js --timeout 15000 --watch",
    "test:verbose": "mocha api.test.js --timeout 15000 --reporter spec",
    "test:integration": "mocha api.test.js --timeout 15000 --grep 'Integration'"
  },
  "devDependencies": {
    "mocha": "^10.2.0",
    "chai": "^4.3.10",
    "supertest": "^6.3.3"
  }
}
