{
  "name": "boulevard-api-tests",
  "version": "1.0.0",
  "description": "Integration test suite for Boulevard API clone",
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS='--experimental-loader ./node_modules/mocha/lib/nodejs/esm-utils.js' mocha --timeout 15000 api.test.js",
    "test:watch": "NODE_OPTIONS='--experimental-loader ./node_modules/mocha/lib/nodejs/esm-utils.js' mocha --timeout 15000 --watch api.test.js",
    "test:verbose": "NODE_OPTIONS='--experimental-loader ./node_modules/mocha/lib/nodejs/esm-utils.js' mocha --timeout 15000 --reporter spec api.test.js",
    "test:integration": "NODE_OPTIONS='--experimental-loader ./node_modules/mocha/lib/nodejs/esm-utils.js' mocha --timeout 15000 --grep 'Integration' api.test.js"
  },
  "devDependencies": {
    "mocha": "^10.2.0",
    "chai": "^4.3.10",
    "supertest": "^6.3.3"
  }
}
